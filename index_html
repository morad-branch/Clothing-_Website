<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>URBANWEAR PRO</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', sans-serif;
  background: #020617;
  color: white;
}

/* NAVBAR */
nav {
  position: sticky;
  top: 0;
  background: rgba(2,6,23,0.8);
  backdrop-filter: blur(10px);
  display: flex;
  justify-content: space-between;
  padding: 15px 40px;
  z-index: 1000;
}

nav h1 {
  color: #22c55e;
}

nav div span {
  margin-left: 20px;
  cursor: pointer;
}

/* HERO */
.hero {
  height: 100vh;
  background: linear-gradient(rgba(0,0,0,0.6),rgba(0,0,0,0.8)),
  url('https://images.unsplash.com/photo-1521335629791-ce4aec67dd47') center/cover;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.hero h2 {
  font-size: 60px;
}

.hero button {
  margin-top: 20px;
  padding: 15px 30px;
  background: #22c55e;
  border: none;
  color: white;
  cursor: pointer;
}

/* FILTER */
.filter {
  text-align: center;
  padding: 20px;
}

.filter button {
  margin: 5px;
  padding: 10px 15px;
  border: none;
  background: #1e293b;
  color: white;
  cursor: pointer;
}

/* PRODUCTS */
.products {
  padding: 40px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
  gap: 20px;
}

.card {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(5px);
  border-radius: 10px;
  padding: 15px;
  transition: 0.3s;
}

.card:hover {
  transform: scale(1.05);
}

.card img {
  width: 100%;
  border-radius: 10px;
}

.card button {
  margin-top: 10px;
  padding: 10px;
  background: #22c55e;
  border: none;
  color: white;
  cursor: pointer;
}

/* CART */
.cart {
  position: fixed;
  right: 0;
  top: 0;
  width: 300px;
  height: 100%;
  background: #020617;
  padding: 20px;
  transform: translateX(100%);
  transition: 0.3s;
}

.cart.active {
  transform: translateX(0);
}

.cart h2 {
  margin-bottom: 20px;
}

.cart-item {
  margin-bottom: 10px;
}

/* FOOTER */
footer {
  text-align: center;
  padding: 20px;
}
</style>
</head>

<body>

<!-- NAV -->
<nav>
  <h1>URBANWEAR</h1>
  <div>
    <span onclick="toggleCart()">🛒 Cart</span>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div>
    <h2>Drop 2026</h2>
    <button onclick="scrollToProducts()">Shop Now</button>
  </div>
</section>

<!-- FILTER -->
<div class="filter">
  <button onclick="filter('all')">All</button>
  <button onclick="filter('hoodie')">Hoodies</button>
  <button onclick="filter('shirt')">Shirts</button>
</div>

<!-- PRODUCTS -->
<section class="products" id="products">
  <div class="grid" id="productGrid"></div>
</section>

<!-- CART -->
<div class="cart" id="cart">
  <h2>Your Cart</h2>
  <div id="cartItems"></div>
</div>

<!-- FOOTER -->
<footer>
  <p>© 2026 URBANWEAR PRO</p>
</footer>

<script>
const products = [
  {name:"Black Hoodie", price:29, category:"hoodie", img:"https://images.unsplash.com/photo-1523381210434-271e8be1f52b"},
  {name:"White Shirt", price:19, category:"shirt", img:"https://images.unsplash.com/photo-1516826957135-700dedea698c"},
  {name:"Street Hoodie", price:35, category:"hoodie", img:"https://images.unsplash.com/photo-1520975916090-3105956dac38"}
];

let cart = [];

function displayProducts(list) {
  let html = "";
  list.forEach(p => {
    html += `
      <div class="card">
        <img src="${p.img}">
        <h3>${p.name}</h3>
        <p>$${p.price}</p>
        <button onclick='addToCart(${JSON.stringify(p)})'>Add to Cart</button>
      </div>
    `;
  });
  document.getElementById("productGrid").innerHTML = html;
}

function filter(cat) {
  if(cat === "all") displayProducts(products);
  else displayProducts(products.filter(p => p.category === cat));
}

function addToCart(product) {
  cart.push(product);
  updateCart();
}

function updateCart() {
  let html = "";
  cart.forEach(p => {
    html += `<div class="cart-item">${p.name} - $${p.price}</div>`;
  });
  document.getElementById("cartItems").innerHTML = html;
}

function toggleCart() {
  document.getElementById("cart").classList.toggle("active");
}

function scrollToProducts() {
  document.getElementById("products").scrollIntoView({behavior:"smooth"});
}

displayProducts(products);
</script>

</body>
</html>
